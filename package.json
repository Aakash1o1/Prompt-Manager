{
  "name": "prompt-manager",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.18.0",
    "typescript": "^5.0.0",
    "@types/chrome": "^0.0.157"
  },
  "scripts": {
    "build": "npm run build:content",
    "build:content": "esbuild src/content.ts --bundle --platform=browser --target=es2019 --outfile=dist/content.js && cp src/content.css dist/content.css",
    "clean": "rm -rf dist"
  }
}
